{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ZeroTrace",
          "informationUri": "https://github.com/zerotrace/zerotrace",
          "rules": [
            {
              "id": "AWS Access Key",
              "name": "AWS Access Key"
            },
            {
              "id": "GitHub Token",
              "name": "GitHub Token"
            },
            {
              "id": "JWT",
              "name": "JWT"
            },
            {
              "id": "Private Key",
              "name": "Private Key"
            },
            {
              "id": "Internal Token",
              "name": "Internal Token"
            },
            {
              "id": "Generic API Key",
              "name": "Generic API Key"
            },
            {
              "id": "Password",
              "name": "Password"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "AWS Access Key",
          "level": "error",
          "message": {
            "text": "AWS Access Key detected by ZeroTrace"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "./testdata/advanced_test.cpp"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ]
        },
        {
          "ruleId": "GitHub Token",
          "level": "error",
          "message": {
            "text": "GitHub Token detected by ZeroTrace"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "./testdata/advanced_test.cpp"
                },
                "region": {
                  "startLine": 4
                }
              }
            }
          ]
        },
        {
          "ruleId": "JWT",
          "level": "error",
          "message": {
            "text": "JWT detected by ZeroTrace"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "./testdata/advanced_test.cpp"
                },
                "region": {
                  "startLine": 5
                }
              }
            }
          ]
        },
        {
          "ruleId": "Private Key",
          "level": "error",
          "message": {
            "text": "Private Key detected by ZeroTrace"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "./testdata/advanced_test.cpp"
                },
                "region": {
                  "startLine": 6
                }
              }
            }
          ]
        },
        {
          "ruleId": "Internal Token",
          "level": "error",
          "message": {
            "text": "Internal Token detected by ZeroTrace"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "./testdata/advanced_test.cpp"
                },
                "region": {
                  "startLine": 7
                }
              }
            }
          ]
        },
        {
          "ruleId": "Generic API Key",
          "level": "error",
          "message": {
            "text": "Generic API Key detected by ZeroTrace"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "./testdata/fake_config.cpp"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ]
        },
        {
          "ruleId": "Password",
          "level": "error",
          "message": {
            "text": "Password detected by ZeroTrace"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "./testdata/fake_config.cpp"
                },
                "region": {
                  "startLine": 4
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
